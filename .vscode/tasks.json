{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "next-dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "ready|Ready|Starting",
          "endsPattern": "ready|Ready|started|started server"
        }
      }
    }
  ]
}
